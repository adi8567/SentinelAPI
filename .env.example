# SentinelAPI Environment Configuration Template
PROJECT_NAME="SentinelAPI"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Security Credentials
SECRET_KEY="sentinel-insecure-dev-key-change-in-production-32charsmin"
ADMIN_API_KEY="sentinel_admin_sec_key_prod_884920"
INGESTION_API_KEYS="sentinel_agent_key_nginx_01928374,sentinel_agent_key_envoy_09182736,sentinel_agent_key_kong_05128374,sentinel_agent_key_aws_08273615,sentinel_agent_key_azure_07182934,sentinel_agent_key_gcp_06192837,sentinel_agent_key_otel_04182930"
ALLOW_ANONYMOUS_INGESTION=false

# Streaming Backend (kafka, memory, file)
STREAMING_BACKEND="memory"
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC_NORMALIZED_EVENTS="sentinelapi.events.normalized"
KAFKA_TOPIC_RAW_EVENTS="sentinelapi.events.raw"

# Time-Series Storage Backend (duckdb, clickhouse, timescaledb)
STORAGE_BACKEND="duckdb"
DUCKDB_PATH="data/sentinel_timeseries.duckdb"

# ClickHouse Configuration (when STORAGE_BACKEND=clickhouse)
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="sentinelapi"

# TimescaleDB / PostgreSQL Configuration
TIMESCALE_HOST="localhost"
TIMESCALE_PORT=5432
TIMESCALE_USER="postgres"
TIMESCALE_PASSWORD="postgrespassword"
TIMESCALE_DATABASE="sentinelapi"

# Logging & Telemetry
LOG_LEVEL="INFO"
LOG_FORMAT="console"
